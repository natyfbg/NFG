# .env.example
# ---------------------------------------------------------
# Copy this file to ".env" and adjust values as needed.
# Never commit your real .env (add it to .gitignore).
# ---------------------------------------------------------

# ---------------------------------------------------------
# Local development (run: python app.py)
# ---------------------------------------------------------
# Local MongoDB connection
MONGO_URI=mongodb://localhost:27017/NFG
MONGO_DB=NFG

# Docker Compose overrides MONGO_URI with mongodb://mongo:27017/NFG so the
# app connects to the Mongo service named "mongo".

# Flask secret for sessions / CSRF protection
SECRET_KEY=dev-secret

# Admin login (used by Flask-Login)
ADMIN_USERNAME=admin
# Either provide a plaintext password (for local use only)
# ADMIN_PASSWORD=changeme
# ...or use a secure hash (for production)
# Keep password hashes containing "$" inside single quotes in backend/.env.
# ADMIN_PASSWORD_HASH='pbkdf2:sha256:600000$...$...'

# ---------------------------------------------------------
# Production (Render)
# ---------------------------------------------------------
# Production uses MongoDB Atlas. MONGO_URI is set manually as a secret
# in the Render dashboard (render.yaml marks it `sync: false`) — it is
# not auto-injected from a Render-hosted Mongo service.
# Example (Mongo Atlas):
# MONGO_URI=mongodb+srv://<user>:<pass>@<cluster-url>/NFG?retryWrites=true&w=majority
# SECRET_KEY=<strong_random_string>
# ADMIN_PASSWORD_HASH=<your_secure_hash>
