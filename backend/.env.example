# .env.example
# ---------------------------------------------------------
# Copy this file to ".env" and adjust values as needed.
# Never commit your real .env (add it to .gitignore).
# ---------------------------------------------------------

# ---------------------------------------------------------
# Local development (run: python app.py)
# ---------------------------------------------------------
# Local MongoDB connection
MONGO_URI=mongodb://localhost:27017/NFG
MONGO_DB=NFG

# Docker Compose overrides MONGO_URI with mongodb://mongo:27017/NFG so the
# app connects to the Mongo service named "mongo".

# Flask secret for sessions / CSRF protection
SECRET_KEY=dev-secret

# Admin login (used by Flask-Login)
ADMIN_USERNAME=admin
# Local development: a plaintext password is allowed. If neither ADMIN_PASSWORD
# nor ADMIN_PASSWORD_HASH is set locally, the password defaults to "changeme".
# ADMIN_PASSWORD=changeme
# If ADMIN_PASSWORD_HASH is set, it is the ONLY accepted credential (no plaintext
# fallback). Generate one with:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('your-password'))"
# Keep password hashes containing "$" inside single quotes in backend/.env.
# ADMIN_PASSWORD_HASH='scrypt:32768:8:1$...$...'
# Accounts that also get admin when they sign in normally (comma-separated emails of
# accounts that already exist). The username/password admin login above stays as a backup.
# ADMIN_EMAILS=you@example.com

# Email (password reset). Without RESEND_API_KEY nothing is sent: the email,
# including the reset link, is written to the app log instead (fine locally).
# RESEND_API_KEY=re_...
# MAIL_FROM="Qiltsim <hello@qiltsim.com>"

# ---------------------------------------------------------
# Production (Render)
# ---------------------------------------------------------
# Production uses MongoDB Atlas. MONGO_URI is set manually as a secret
# in the Render dashboard (render.yaml marks it `sync: false`) — it is
# not auto-injected from a Render-hosted Mongo service.
#
# On Render (RENDER is set) the app REFUSES TO START unless both a real
# SECRET_KEY and ADMIN_PASSWORD_HASH are set. Plaintext ADMIN_PASSWORD is
# ignored there. A failed start leaves the previous deploy serving traffic.
# Example (Mongo Atlas):
# MONGO_URI=mongodb+srv://<user>:<pass>@<cluster-url>/NFG?retryWrites=true&w=majority
# SECRET_KEY=<strong_random_string>
# ADMIN_PASSWORD_HASH=<your_secure_hash>
#
# Domain and email (set in the Render dashboard):
# CANONICAL_HOST=qiltsim.com   # only once the custom domain shows "Verified" in Render:
#                              # www. and *.onrender.com then 301 to it
# RESEND_API_KEY=re_...        # password reset stays hidden on Render until this is set
