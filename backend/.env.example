# .env.example
# ---------------------------------------------------------
# Copy this file to ".env" and adjust values as needed.
# Never commit your real .env (add it to .gitignore).
# ---------------------------------------------------------

# ---------------------------------------------------------
# Local development (run: python app.py)
# ---------------------------------------------------------
# Local MongoDB connection
MONGO_URI=mongodb://localhost:27017/NFG
# Optional: specify database name separately (not required if above includes it)
# MONGO_DB=NFG

# Flask secret for sessions / CSRF protection
SECRET_KEY=dev-secret

# Admin login (used by Flask-Login)
ADMIN_USERNAME=Admin
# Preferred: use a Werkzeug-compatible hash for the local dev password `#RahelaGebre`
ADMIN_PASSWORD_HASH=pbkdf2:sha256:600000$W1mTYff48Gzmnklc$ad72bbb34c24785ea692c1fe1dba38a32840f27b5fbca5d24a9128b2a9b66a8c
# Optional plaintext dev fallback only when no hash is configured
# ADMIN_PASSWORD=#RahelaGebre

# ---------------------------------------------------------
# Production (Render, Docker, etc.)
# ---------------------------------------------------------
# Render automatically injects environment variables via the dashboard.
# Example (Mongo Atlas):
# MONGO_URI=mongodb+srv://<user>:<pass>@<cluster-url>/NFG?retryWrites=true&w=majority
# SECRET_KEY=<strong_random_string>
# ADMIN_PASSWORD_HASH=<your_secure_hash>
